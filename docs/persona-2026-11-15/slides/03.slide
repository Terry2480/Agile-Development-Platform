<Slide style={{ width: '1280px', height: '720px', background: '#F5F5F5', padding: '60px' }}>
  <Box style={{ width: '100%', height: '100%', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box>
      <Text style={{ fontSize: 14, color: '#2A5E96', letterSpacing: 3 }}>03 / 角色</Text>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#081F5C' }}>谁在使用 AgileCampus</Text>
      <Box style={{ height: 10, width: '100%', borderBottom: '1px solid #D4D7E0' }} />
    </Box>
    <Box style={{ width: '100%', height: 390, flexDirection: 'row', alignItems: 'center', gap: 20 }}>
      <svg width={1100} height={390} viewBox='0 0 1100 390'>
        <rect x='330' y='20' width='440' height='86' rx='8' fill='#334EAC' />
        <text x='550' y='56' textAnchor='middle' fill='#FFFFFF' fontSize='24' fontWeight='bold'>教师 · 监督者</text>
        <text x='550' y='86' textAnchor='middle' fill='#DCE4FA' fontSize='16'>跨组进度检查 · 反馈 · 只读视图</text>
        <path d='M550 106 L380 146' stroke='#737FA1' strokeWidth='2' fill='none' />
        <path d='M395 148 L380 148 L392 137' stroke='#737FA1' strokeWidth='2' fill='none' />
        <rect x='160' y='150' width='440' height='86' rx='8' fill='#203988' />
        <text x='380' y='186' textAnchor='middle' fill='#FFFFFF' fontSize='24' fontWeight='bold'>组长 · 组织者</text>
        <text x='380' y='216' textAnchor='middle' fill='#DCE4FA' fontSize='16'>分工 · 迭代节奏 · 汇总汇报</text>
        <path d='M380 236 L310 276' stroke='#737FA1' strokeWidth='2' fill='none' />
        <path d='M325 278 L310 278 L319 266' stroke='#737FA1' strokeWidth='2' fill='none' />
        <rect x='90' y='280' width='440' height='86' rx='8' fill='#27707F' />
        <text x='310' y='316' textAnchor='middle' fill='#FFFFFF' fontSize='24' fontWeight='bold'>组员 · 执行者</text>
        <text x='310' y='346' textAnchor='middle' fill='#DCE4FA' fontSize='16'>认领任务 · 更新状态 · 记录进度</text>
        <rect x='620' y='150' width='430' height='216' rx='8' fill='#ECECEC' stroke='#D4D7E0' strokeWidth='1' />
        <text x='650' y='188' fill='#081F5C' fontSize='19' fontWeight='bold'>用例侧写</text>
        <text x='650' y='222' fill='#20346B' fontSize='16'>同一位学生，在小组内是组员，</text>
        <text x='650' y='250' fill='#20346B' fontSize='16'>在另一门课可能是组长；</text>
        <text x='650' y='278' fill='#20346B' fontSize='16'>教师也可能同时指导多个小组。</text>
        <text x='650' y='322' fill='#334EAC' fontSize='17' fontWeight='bold'>一人可扮演多个角色 →</text>
        <text x='650' y='350' fill='#334EAC' fontSize='17' fontWeight='bold'>角色是行为模式，不是身份标签</text>
