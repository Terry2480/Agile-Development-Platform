DATABASE_URL=postgres://agilecampus:agilecampus_dev@localhost:5432/agilecampus
AUTH_SECRET=change-me-run-npx-auth-secret
# 对外访问地址（飞书 OAuth 回调据此拼跳转，生产须设真实域名）
AGILECAMPUS_URL=http://localhost:3001
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型番号：缺省 deepseek-v4-flash（迅捷省耗）；重推理可换 deepseek-v4-pro。
# 注意：旧番号 deepseek-chat 已被 DeepSeek 废弃，填之必返 400。
DEEPSEEK_MODEL=deepseek-v4-flash

# 生产 compose（docker-compose.prod.yml）粮草密码——变量插值单一来源，勿留空
POSTGRES_PASSWORD=change-me-strong-password

# 飞书自建应用（Lark）——绑定成员 + 消息提醒
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3001/api/auth/feishu/callback
FEISHU_BASE_URL=https://open.feishu.cn
# 定时提醒 cron 端点保护密钥（自定义高熵串，如 openssl rand -hex 32）
CRON_SECRET=
